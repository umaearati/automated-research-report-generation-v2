# --- LLM providers ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
LLM_PROVIDER=openai   # one of: openai | google | groq | huggingface

# --- Search ---
TAVILY_API_KEY=

# --- Caching (Redis) ---
# If unset, falls back to an in-memory cache for the current process only.
REDIS_URL=redis://localhost:6379/0

# --- PII redaction (Presidio) ---
# No API key required — presidio-analyzer / presidio-anonymizer run locally.
# Requires: pip install presidio-analyzer presidio-anonymizer
#           python -m spacy download en_core_web_lg

# --- Vector storage (Pinecone) ---
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-report-generator


LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
